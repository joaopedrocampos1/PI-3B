  "2" [style=filled, fillcolor="#eb6834"];
  "3" [style=filled, fillcolor="#2a78d6"];
  "4" [style=filled, fillcolor="#2a78d6"];
  "5" [style=filled, fillcolor="#2a78d6"];
  "6";
  "7";
  "8";
  "9";
  "10";
  "11";
  "0" -> "1";
  "1" -> "2";
  "2" -> "0";
  "2" -> "3";
  "3" -> "4";
  "4" -> "5";
  "5" -> "3";
  "5" -> "6";
  "6" -> "7";
  "7" -> "8";
  "9" -> "10";
  "10" -> "11";
}
